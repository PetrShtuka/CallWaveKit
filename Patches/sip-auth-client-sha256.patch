-                                              (unsigned)len)
+
+/*
+ * CallWaveKit patch: built without OpenSSL (the XCFramework uses Apple's TLS
+ * stack), upstream PJSIP answers MD5 digest challenges only. RFC 8760 servers
+ * increasingly challenge with SHA-256, so the OpenSSL-shaped calls in this
+ * file are dispatched onto pj_md5 or the bundled SHA-256 implementation.
+ */
+#include "callwave_sha256.h"
+
+typedef struct cw_evp_ctx {
+    int use_sha256;
+    pj_md5_context md5;
+    cw_sha256_ctx sha256;
+} cw_evp_ctx;
+
+static void cw_evp_init(cw_evp_ctx *ctx, const char *name) {
+    ctx->use_sha256 = name != NULL && strcmp(name, "SHA256") == 0;
+    if (ctx->use_sha256) {
+        cw_sha256_init(&ctx->sha256);
+    } else {
+        pj_md5_init(&ctx->md5);
+    }
+}
+
+static void cw_evp_update(cw_evp_ctx *ctx, const void *data, unsigned len) {
+    if (ctx->use_sha256) {
+        cw_sha256_update(&ctx->sha256, (const cw_sha256_byte *)data, len);
+    } else {
+        pj_md5_update(&ctx->md5, (const pj_uint8_t *)data, len);
+    }
+}
+
+static void cw_evp_final(cw_evp_ctx *ctx, unsigned char *digest) {
+    if (ctx->use_sha256) {
+        cw_sha256_final(&ctx->sha256, digest);
+    } else {
+        pj_md5_final(&ctx->md5, digest);
+    }
+}
